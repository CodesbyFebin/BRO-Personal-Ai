# Optional local Ollama model. Leave blank to use the explicitly labeled demo fallback.
BRO_OLLAMA_MODEL=
BRO_OLLAMA_URL=http://127.0.0.1:11434/api/chat
BRO_HOST=127.0.0.1
BRO_PORT=8787
# Optional selectable inference roster. Model APIs and keys are configured on the server;
# never put provider keys in web/index.html or a browser setting.
# Supports OpenAI-compatible endpoints (OpenAI, OpenRouter, Groq, Together, etc.), Anthropic Messages, Gemini generateContent, and Ollama.
# Mark public endpoints trust_domain=remote. Prompt and draft text will leave this device.
# BRO_MODELS='[{"id":"gpt-primary","protocol":"openai","model":"YOUR_MODEL_ID","base_url":"https://api.openai.com/v1","trust_domain":"remote","api_key_env":"OPENAI_API_KEY"},{"id":"claude-main","protocol":"anthropic","model":"YOUR_MODEL_ID","base_url":"https://api.anthropic.com/v1","trust_domain":"remote","api_key_env":"ANTHROPIC_API_KEY"},{"id":"gemini-main","protocol":"gemini","model":"YOUR_MODEL_ID","base_url":"https://generativelanguage.googleapis.com/v1beta","trust_domain":"remote","api_key_env":"GEMINI_API_KEY"}]'
# Set secret values in your process environment, for example: OPENAI_API_KEY, ANTHROPIC_API_KEY, GEMINI_API_KEY.
# Optional JSON array of independent Ollama/OpenAI-compatible reviewers.
# Remote providers require trust_domain=remote; prompt and draft text will leave this device.
# BRO_DEBATE_PROVIDERS='[{"id":"local-a","protocol":"ollama","model":"qwen2.5:7b","base_url":"http://127.0.0.1:11434/api/chat","trust_domain":"local"},{"id":"local-b","protocol":"ollama","model":"llama3.2:3b","base_url":"http://127.0.0.1:11434/api/chat","trust_domain":"local"}]'
